# Copy to .env.local and fill in the real credentials, then run `npm run dev`.
# For local tests against the espresso sandbox, copy it to .env.sandbox instead
# (ESPRESSO_MODE='test') and keep .env.local for the production settings.
# .env.local is git-ignored — never commit credentials.
#
# Environment note: the routing profile differs between environments.
#   production → "Profile 718524 DID E164"
#   test       → "Test Profile"
# These are the labels SOAP listed. DID orders now go over REST, which matches
# ESPRESSO_DID_PROFILE against its routing profile labels — check them with
# GET /api/did/profiles (the sandbox may differ).
# LNP v4 exposes "Profile 718524 DID E164" as id 2408 in BOTH environments.

# espresso login: SOAP (rate-center catalog, porting), and the REST login
# unless ESPRESSO_REST_USER/PASS are set
export ESPRESSO_USER='jerwin@iristel.com'
export ESPRESSO_PASS='REPLACE_ME'

# test | production — also picks the REST host:
#   test → https://api-sandbox.espressodid.com, production → https://api.espressodid.com
export ESPRESSO_MODE='test'

# espresso REST API (number inventory + DID orders) OAuth client. Without these
# the number picker and DID ordering are off (/api/config didReady:false).
export ESPRESSO_CLIENT_ID='REPLACE_ME'
export ESPRESSO_CLIENT_SECRET='REPLACE_ME'

# Optional: a separate REST login, e.g. when the sandbox has its own account.
# export ESPRESSO_REST_USER='REPLACE_ME'
# export ESPRESSO_REST_PASS='REPLACE_ME'

# Optional: override the REST host that ESPRESSO_MODE picks.
# export ESPRESSO_REST_URL='https://api-sandbox.espressodid.com'

# Optional: espresso company id. Unset = the login's only active company.
# export ESPRESSO_COMPANY_ID='REPLACE_ME'

# Optional: routing profile id. Unset = the active DID profile whose label
# matches ESPRESSO_DID_PROFILE.
# export ESPRESSO_ROUTING_PROFILE_ID='REPLACE_ME'

# Optional: OCN numbers are bought under — Iristel's own. Default 154E.
# export ESPRESSO_OCN='154E'

# Pin the routing profile (matched against the REST routing profile labels).
# The server refuses to order if the pinned profile is not on the account,
# rather than silently using the wrong one.
# For ESPRESSO_MODE=test:
export ESPRESSO_DID_PROFILE='Test Profile'
# For ESPRESSO_MODE=production, use instead:
# export ESPRESSO_DID_PROFILE='Profile 718524 DID E164'

export ESPRESSO_LNP_PROFILE='2408'

# UbossRobot reseller every provisioning job is filed under. Defaults to
# 'Demo Reseller' (the only one with completed jobs). Switch to 'IRISTEL'
# once the UBoss exact-match reseller lookup fix is deployed.
# export UBOSS_RESELLER_NAME='Demo Reseller'

# Optional: restrict the DID catalog to NPAs with a working "+1-<npa>"
# number pool in UBoss. Unset = no filter (pool lookup fixed 2026-09-10).
# export UBOSS_POOL_NPAS='204,416,647,431,604'

# Dynamics 365 — completed orders are pushed as Contacts ("Sip Order").
# Without these the CRM sync is skipped (logged, never blocks the customer).
export D365_TENANT_ID='REPLACE_ME'
export D365_CLIENT_ID='REPLACE_ME'
export D365_CLIENT_SECRET='REPLACE_ME'
export D365_URL='https://iris-sandbox.crm3.dynamics.com'
